{
  "name": "loam",
  "description": "A block theme with an earthy palette and generous type.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/philhoyt/loam"
  },
  "scripts": {
    "start": "wp-scripts start --experimental-modules",
    "build": "wp-scripts build --experimental-modules",
    "format": "wp-scripts format",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "lint:js": "wp-scripts lint-js",
    "lint:scss": "stylelint 'src/**/*.scss' --formatter verbose",
    "lint:scss:fix": "stylelint 'src/**/*.scss' --fix",
    "lint:php": "composer run-script lint",
    "lint:php:fix": "composer run-script lint-fix",
    "packages-update": "wp-scripts packages-update",
    "screenshot": "node bin/screenshot.js",
    "validate:blocks": "node bin/validate-blocks.js",
    "patterns:flush": "bin/wp.sh eval \"\\$t = wp_get_theme(); \\$m = new ReflectionMethod( \\$t, 'delete_pattern_cache' ); \\$m->setAccessible( true ); \\$m->invoke( \\$t ); echo count( \\$t->get_block_patterns() ), \\\" patterns registered\\\\n\\\";\"",
    "check:contrast": "node bin/check-contrast.js"
  },
  "overrides": {
    "@sentry/node": {
      "minimatch": "9.0.9"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "markdownlint-cli": {
      "minimatch": "3.1.5"
    },
    "serialize-javascript": "7.0.5",
    "webpack-dev-server": "5.2.3"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3.0.0",
    "@wordpress/block-library": "^11.0.0",
    "@wordpress/blocks": "^16.0.0",
    "@wordpress/dependency-extraction-webpack-plugin": "^6.43.0",
    "@wordpress/env": "^11.15.0",
    "@wordpress/scripts": "^32.2.0",
    "editorconfig": "^3.0.1",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.9.4",
    "prettier": "^3.0.0",
    "puppeteer": "^24.0.0",
    "sass": "^1.86.3",
    "stylelint": "^16.0.0",
    "stylelint-config-standard-scss": "^13.0.0"
  }
}
