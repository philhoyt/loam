{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "radius": true,
      "radiusSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "0.125rem"
        },
        {
          "name": "Small",
          "slug": "sm",
          "size": "0.25rem"
        },
        {
          "name": "Medium",
          "slug": "md",
          "size": "0.375rem"
        },
        {
          "name": "Large",
          "slug": "lg",
          "size": "0.5rem"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "0.75rem"
        },
        {
          "name": "2XL",
          "slug": "2-xl",
          "size": "1rem"
        },
        {
          "name": "3XL",
          "slug": "3-xl",
          "size": "1.5rem"
        }
      ]
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#F6EDE2",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#141312",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#EC5038",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#2A211C",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#1E6F78",
          "name": "Tertiary",
          "slug": "tertiary"
        },
        {
          "color": "#4A423B",
          "name": "Contrast Dark",
          "slug": "contrast-dark"
        },
        {
          "color": "#8E8378",
          "name": "Contrast Medium",
          "slug": "contrast-medium"
        },
        {
          "color": "#EADFCF",
          "name": "Contrast Light",
          "slug": "contrast-light"
        }
      ]
    },
    "custom": {
      "button": {
        "outline": {
          "borderWidth": "2px"
        }
      },
      "lineHeight": {
        "small": "1.3",
        "medium": "1.6",
        "large": "1.8"
      },
      "navigation": {
        "submenu": {
          "max-width": "22rem",
          "offset": "0.6rem",
          "radius": "0.5rem",
          "shadow": "0 14px 32px -10px color-mix(in srgb, var(--wp--preset--color--contrast) 22%, transparent), 0 2px 6px color-mix(in srgb, var(--wp--preset--color--contrast) 8%, transparent)"
        },
        "underline": {
          "height": "3px"
        },
        "toggle": {
          "width": "28px",
          "bar": "4px",
          "gap": "5px"
        }
      },
      "outline": {
        "width": "2px",
        "offset": "2px",
        "style": "solid"
      },
      "sectionPadding": {
        "block": "clamp(3.5rem, 7vw, 7rem)"
      },
      "tile": {
        "ratio": "4 / 5"
      },
      "radius": {
        "small": "0.25rem",
        "medium": "0.5rem"
      },
      "gutter": {
        "inline": "clamp(1.5rem, 3vw, 3.5rem)"
      }
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1920px"
    },
    "spacing": {
      "customSpacingSize": true,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "X-Small",
          "size": "0.5rem",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "s"
        },
        {
          "name": "Medium",
          "size": "1.5rem",
          "slug": "m"
        },
        {
          "name": "Large",
          "size": "clamp(2rem, 3vw, 3rem)",
          "slug": "l"
        },
        {
          "name": "X-Large",
          "size": "clamp(3rem, 5vw, 5rem)",
          "slug": "xl"
        },
        {
          "name": "2X-Large",
          "size": "clamp(5rem, 8vw, 8rem)",
          "slug": "xxl"
        },
        {
          "name": "3X-Large",
          "size": "clamp(8rem, 12vw, 12rem)",
          "slug": "xxxl"
        }
      ],
      "units": ["rem", "em", "%", "vw", "vh", "px"]
    },
    "typography": {
      "customFontSize": true,
      "defaultFontSizes": false,
      "dropCap": true,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Unbounded, 'Arial Black', Impact, sans-serif",
          "name": "Unbounded",
          "slug": "display",
          "fontFace": [
            {
              "fontFamily": "Unbounded",
              "fontStyle": "normal",
              "fontWeight": "200 900",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/unbounded/unbounded-normal.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
          "name": "Space Grotesk",
          "slug": "body",
          "fontFace": [
            {
              "fontFamily": "Space Grotesk",
              "fontStyle": "normal",
              "fontWeight": "300 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/space-grotesk/space-grotesk-normal.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "name": "2X-Small",
          "size": "0.75rem",
          "slug": "xxs"
        },
        {
          "name": "X-Small",
          "size": "0.875rem",
          "slug": "xs"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "s"
        },
        {
          "name": "Medium",
          "size": "1.125rem",
          "slug": "m"
        },
        {
          "fluid": {
            "min": "1.25rem",
            "max": "1.5rem"
          },
          "name": "Large",
          "size": "1.5rem",
          "slug": "l"
        },
        {
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          },
          "name": "X-Large",
          "size": "2rem",
          "slug": "xl"
        },
        {
          "fluid": {
            "min": "1.75rem",
            "max": "2.75rem"
          },
          "name": "2X-Large",
          "size": "2.75rem",
          "slug": "xxl"
        },
        {
          "fluid": {
            "min": "2.25rem",
            "max": "4rem"
          },
          "name": "3X-Large",
          "size": "4rem",
          "slug": "xxxl"
        }
      ],
      "fontStyle": true,
      "fontWeight": true,
      "textDecoration": true,
      "textTransform": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "blocks": {
      "core/avatar": {
        "border": {
          "radius": "50%"
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "style": "solid",
              "width": "var(--wp--custom--button--outline--border-width)"
            },
            "color": {
              "background": "transparent",
              "text": "currentColor"
            },
            "spacing": {
              "padding": {
                "bottom": "calc(var(--wp--preset--spacing--xs) - var(--wp--custom--button--outline--border-width))",
                "left": "calc(var(--wp--preset--spacing--m) - var(--wp--custom--button--outline--border-width))",
                "right": "calc(var(--wp--preset--spacing--m) - var(--wp--custom--button--outline--border-width))",
                "top": "calc(var(--wp--preset--spacing--xs) - var(--wp--custom--button--outline--border-width))"
              }
            }
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--s)"
        }
      },
      "core/column": {},
      "core/columns": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--m)"
        }
      },
      "core/comment-author-name": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)",
          "fontWeight": "700"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-content": {
        "border": {
          "radius": "var(--wp--custom--radius--small)"
        },
        "color": {
          "background": "var(--wp--preset--color--contrast-light)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--s)",
            "right": "var(--wp--preset--spacing--m)",
            "bottom": "var(--wp--preset--spacing--s)",
            "left": "var(--wp--preset--spacing--m)"
          }
        },
        "css": "& > * { margin-block: 0.75rem 0; } & > :first-child { margin-block-start: 0; }"
      },
      "core/comment-date": {
        "color": {
          "text": "var(--wp--preset--color--contrast-dark)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-edit-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-reply-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/comment-template": {
        "css": "& ol { margin-inline-start: var(--wp--preset--spacing--l); } & li { margin-block-end: 0; }"
      },
      "core/comments-pagination": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        }
      },
      "core/comments-pagination-numbers": {
        "css": "& .page-numbers { padding: 0 0.25rem; } & .page-numbers.current { text-decoration: underline; text-underline-offset: 0.3em; }"
      },
      "core/comments-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        }
      },
      "core/cover": {
        "color": {
          "text": "var(--wp--preset--color--base)"
        },
        "elements": {
          "heading": {
            "color": {
              "text": "var(--wp--preset--color--base)"
            }
          },
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--base)"
              }
            },
            "color": {
              "text": "var(--wp--preset--color--base)"
            }
          }
        }
      },
      "core/gallery": {
        "spacing": {
          "blockGap": "var(--wp--preset--spacing--s)"
        }
      },
      "core/group": {},
      "core/heading": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/image": {
        "border": {
          "radius": "var(--wp--custom--radius--small)"
        }
      },
      "core/latest-comments": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)"
        },
        "css": "& .wp-block-latest-comments__comment { margin-block-end: var(--wp--preset--spacing--s); } & .wp-block-latest-comments__comment-date { font-size: inherit; } & .wp-block-latest-comments__comment-excerpt p { font-size: inherit; margin: 0.25rem 0 0; }"
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "none"
              }
            },
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--s)",
          "fontWeight": "700",
          "letterSpacing": "0.06em",
          "textTransform": "uppercase"
        }
      },
      "core/navigation-submenu": {
        "color": {
          "background": "var(--wp--preset--color--base)",
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "core/post-author-biography": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)"
        }
      },
      "core/post-author-name": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-comments-form": {
        "css": "& .comment-form > * { margin-block: var(--wp--preset--spacing--s) 0; } & .comment-form-cookies-consent { display: flex; align-items: baseline; gap: 0.5em; } & .comment-form-cookies-consent label { font-weight: 400; } & label { font-size: var(--wp--preset--font-size--xs); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; } & .comment-reply-title { font-family: var(--wp--preset--font-family--display); font-size: var(--wp--preset--font-size--l); text-transform: uppercase; } & .comment-reply-title small { font-family: var(--wp--preset--font-family--body); font-size: var(--wp--preset--font-size--xs); margin-inline-start: 0.5em; }"
      },
      "core/post-comments-link": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        }
      },
      "core/post-date": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--xs)",
          "fontWeight": "700",
          "letterSpacing": "0.1em",
          "textTransform": "uppercase"
        },
        "elements": {
          "link": {
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "var(--wp--custom--radius--small)"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xs)"
        },
        "css": "&.taxonomy-post_tag { display: flex; flex-wrap: wrap; align-items: center; gap: var(--wp--preset--spacing--xs); } &.taxonomy-post_tag .wp-block-post-terms__separator { display: none; } &.taxonomy-post_tag a { background-color: var(--wp--preset--color--contrast-light); color: var(--wp--preset--color--contrast); border-radius: var(--wp--custom--radius--small); padding: 0.3em 0.9em; text-decoration: none; transition: background-color 140ms ease; } &.taxonomy-post_tag a:hover, &.taxonomy-post_tag a:focus { background-color: var(--wp--preset--color--contrast-medium); }",
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "800",
          "textTransform": "uppercase"
        }
      },
      "core/pullquote": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "textTransform": "uppercase"
        }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary)",
            "style": "solid",
            "width": "4px"
          }
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--m)"
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--body)",
          "fontSize": "var(--wp--preset--font-size--l)",
          "fontWeight": "500"
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 3px 0"
        },
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--s)"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "text": "var(--wp--preset--color--contrast)"
              },
              "typography": {
                "textDecoration": "underline"
              }
            },
            "color": {
              "text": "currentColor"
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontWeight": "800",
          "lineHeight": "1.1",
          "textTransform": "uppercase"
        }
      },
      "core/details": {
        "border": {
          "top": {
            "color": "var(--wp--preset--color--contrast)",
            "style": "solid",
            "width": "2px"
          }
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--s)",
            "bottom": "var(--wp--preset--spacing--s)"
          }
        },
        "css": "& > summary { font-family: var(--wp--preset--font-family--display); font-weight: 700; text-transform: uppercase; font-size: var(--wp--preset--font-size--s); } & > summary::marker { color: var(--wp--preset--color--primary); }"
      },
      "core/site-logo": {
        "css": "& img { max-height: 3.5rem; width: auto; }"
      },
      "core/accordion": {
        "spacing": {
          "blockGap": "0"
        },
        "border": {
          "bottom": {
            "color": "var(--wp--preset--color--contrast)",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "core/accordion-item": {
        "border": {
          "top": {
            "color": "var(--wp--preset--color--contrast)",
            "style": "solid",
            "width": "2px"
          }
        },
        "spacing": {
          "blockGap": "0"
        }
      },
      "core/accordion-heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontSize": "var(--wp--preset--font-size--m)",
          "fontWeight": "700",
          "letterSpacing": "0",
          "lineHeight": "1.2",
          "textTransform": "uppercase"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--s)",
            "right": "0",
            "bottom": "var(--wp--preset--spacing--s)",
            "left": "0"
          }
        },
        "css": "& .wp-block-accordion-heading__toggle { gap: var(--wp--preset--spacing--m); text-align: start; } & .wp-block-accordion-heading__toggle-icon { color: var(--wp--preset--color--primary); font-weight: 400; } & .wp-block-accordion-heading__toggle:hover .wp-block-accordion-heading__toggle-title { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; text-decoration-color: var(--wp--preset--color--primary); }"
      },
      "core/accordion-panel": {
        "spacing": {
          "padding": {
            "top": "0",
            "right": "0",
            "bottom": "var(--wp--preset--spacing--m)",
            "left": "0"
          }
        },
        "css": "& > * { margin-block: 0.75rem 0; } & > :first-child { margin-block-start: 0; }"
      }
    },
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "var(--wp--custom--radius--small)"
        },
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--preset--spacing--xs)",
